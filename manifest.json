{
  "manifest_version": 3,
  "name": "Google Docs Auto Word Count",
  "version": "1.1",
  "description": "Automatically enables the Google Docs word count bar.",
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/d/*",
        "https://docs.google.com/document/u/*/d/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
